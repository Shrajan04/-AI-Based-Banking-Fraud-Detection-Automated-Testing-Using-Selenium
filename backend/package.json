{
  "name": "ai-banking-fraud-detection-backend",
  "version": "1.0.0",
  "description": "Backend for the AI-Based Banking Fraud Detection & Automated Testing Using Selenium project",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed/seed.js",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.test.js",
    "test:e2e": "npx --yes selenium-side-runner -w 1 --filter TC- -c \"browserName=chrome\" ../selenium/banking-fraud-testing.side"
  },
  "author": "Student Project",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "mongoose": "^8.9.5"
  },
  "engines": {
    "node": ">=18"
  }
}
