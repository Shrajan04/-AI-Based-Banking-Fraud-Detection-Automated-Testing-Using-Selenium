# Copy this file to ".env" and change values if needed.

# Port on which the backend (and the frontend pages) are served
PORT=3000

# Local MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/banking_fraud_db

# Secret used to sign the session cookie (any random text)
SESSION_SECRET=change-this-secret-for-your-project

# TEST_MODE=true enables:
#   - the /reset.html page and POST /api/test/reset (reloads demo data)
#   - the "Custom Test Time" option on the transfer page
# Keep it true while running the Selenium IDE tests.
TEST_MODE=true
